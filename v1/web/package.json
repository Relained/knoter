{
  "name": "knoter-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "React Electron-style workspace template with panes, tabs, command palette, floating windows, and movable bars.",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "electron .",
    "build": "vite build",
    "check": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:hint": "node -e \"console.log('npm run dev starts Vite and the Electron shell on 127.0.0.1:39281.')\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.2.0",
    "typescript": "^6.0.3"
  }
}
